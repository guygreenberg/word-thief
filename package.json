{
  "name": "word-thief",
  "version": "1.0.0",
  "private": true,
  "description": "A party game: make other players say your word and steal theirs.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"node --env-file-if-exists=.env --watch server/index.js\" \"vite\"",
    "dev:https": "concurrently -k -n server,client -c magenta,cyan \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --mode https\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test server/"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "express": "^5.3.0",
    "qr-scanner": "^1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
